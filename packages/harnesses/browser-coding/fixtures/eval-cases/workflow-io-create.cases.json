{
  "cases": [
    {
      "id": "wf-create-io-01",
      "suite": "workflow-create",
      "title": "Accepts prompt with ref from input",
      "harness": "workflow-authoring",
      "model": "default",
      "input": {
        "request": "Create workflow generate-from-prompt that accepts a required string prompt run input field and wires generate step input from ref(\"prompt\") using @executioncontrolprotocol/ollama.generate."
      },
      "assertions": {
        "deterministic": [
          {
            "kind": "invokeSuccess"
          },
          {
            "kind": "artifactSchema",
            "value": "@executioncontrolprotocol.workflow"
          },
          {
            "kind": "validationValid"
          },
          {
            "kind": "workflowAcceptsHasProperties",
            "properties": [
              "prompt"
            ]
          },
          {
            "kind": "workflowAcceptsRefUsed",
            "property": "prompt"
          },
          {
            "kind": "stepUses",
            "capabilityId": "@executioncontrolprotocol/ollama.generate"
          }
        ],
        "judge": {
          "enabled": false
        }
      }
    },
