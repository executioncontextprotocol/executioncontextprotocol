{
  "cases": [
    {
      "id": "wf-create-01",
      "suite": "workflow-create",
      "title": "Minimal generate",
      "harness": "workflow-authoring",
      "model": "default",
      "input": {
        "request": "Create a minimal @executioncontrolprotocol.workflow with one step that uses @executioncontrolprotocol/chrome-ai.generate to summarize the text hello in one sentence."
      },
      "assertions": {
        "deterministic": [
          {
            "kind": "invokeSuccess"
          },
          {
            "kind": "artifactSchema",
            "value": "@executioncontrolprotocol.workflow"
          },
          {
            "kind": "validationValid"
          },
          {
            "kind": "descriptorListsExtensions",
            "ids": [
              "@executioncontrolprotocol/format-toon",
              "@executioncontrolprotocol/format-eql",
              "@executioncontrolprotocol/format-json",
              "@executioncontrolprotocol/test"
            ]
          },
          {
            "kind": "stepUses",
            "capabilityId": "@executioncontrolprotocol/chrome-ai.generate"
          },
          {
            "kind": "stepCount",
            "exact": 1
          }
        ],
        "judge": {
          "enabled": false
        }
      }
    },
