{
  "cases": [
    {
      "id": "chat-01",
      "suite": "chat",
      "title": "Troubleshoot failure routes to patch with summary",
      "harness": "chat",
      "model": "default",
      "input": {
        "message": "The workflow failed on poem, help me fix it.",
        "manifestRef": "workflows/two-step-generate-chain.json"
      },
      "assertions": {
        "deterministic": [
          {
            "kind": "invokeSuccess"
          },
          {
            "kind": "classifiedIntent",
            "value": "workflow-patch"
          },
          {
            "kind": "shotCount",
            "value": 3
          },
          {
            "kind": "promptPhase",
            "shotIndex": 0,
            "value": "unfiltered"
          },
          {
            "kind": "promptPhase",
            "shotIndex": 1,
            "value": "contextualized"
          },
          {
            "kind": "shotTask",
            "shotIndex": 2,
            "task": "workflow-change-summary"
          },
          {
            "kind": "replySchema"
          },
          {
            "kind": "replyAction",
            "value": "offer-run"
          },
          {
            "kind": "sidecarWorkflowSchema",
            "value": "@executioncontrolprotocol.workflow"
          },
          {
            "kind": "validationValid"
          }
        ],
        "judge": {
          "enabled": true,
          "goal": "Summarizes the workflow fix and asks whether to run it",
          "rubric": "One or two sentences about the change; asks to run; no markdown fences",
          "requireApproved": true
        }
      }
    },
