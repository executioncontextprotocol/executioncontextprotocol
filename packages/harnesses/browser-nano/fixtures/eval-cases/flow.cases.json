          "assertions": {
            "deterministic": [
              {
                "kind": "intent",
                "value": "workflow-create"
              }
            ],
            "judge": {
              "enabled": false
            }
          }
        },
        {
          "harness": "workflow-authoring",
          "input": {
            "request": "Create minimal @executioncontrolprotocol/chrome-ai.generate workflow."
          },
          "assertions": {
            "deterministic": [
