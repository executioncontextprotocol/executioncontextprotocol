    {
      "id": "flow-10",
      "suite": "flow",
      "title": "Chat create then chat fix failed run",
      "model": "default",
      "steps": [
        {
          "harness": "chat",
          "input": {
            "message": "I need a new workflow with poem then summarize using generate."
          },
          "assertions": {
            "deterministic": [
              {
                "kind": "invokeSuccess"
              },
              {
                "kind": "classifiedIntent",
                "value": "workflow-create"
              },
              {
                "kind": "shotCount",
                "value": 3
              },
              {
                "kind": "replySchema"
              },
              {
                "kind": "replyAction",
                "value": "offer-run"
              },
              {
                "kind": "sidecarWorkflowSchema",
                "value": "@executioncontrolprotocol.workflow"
              }
            ],
            "judge": {
              "enabled": false
            }
          }
        },
        {
          "harness": "chat",
          "input": {
            "message": "The last workflow run failed. Diagnose the errors from the run context and patch the workflow to fix them.",
            "manifestRef": "workflows/two-step-generate-chain.json",
            "runContextFixture": "runs/failed-generate-step.json"
          },
          "assertions": {
            "deterministic": [
              {
                "kind": "invokeSuccess"
              },
              {
                "kind": "shotCount",
                "value": 3
              },
              {
                "kind": "replySchema"
              },
              {
                "kind": "replyAction",
                "value": "offer-run"
              },
              {
                "kind": "sidecarWorkflowSchema",
                "value": "@executioncontrolprotocol.workflow"
              }
            ],
            "judge": {
              "enabled": false
            }
          }
        }
      ]
    },
    {
      "id": "flow-probe-clarify-complete-01",
      "suite": "flow",
      "title": "Probe then clarify and complete",
      "model": "default",
      "steps": [
        {
          "harness": "chat",
          "input": {
            "message": "Inspect the Photoshop layers before choosing which one to edit."
          },
          "assertions": {
            "deterministic": [
              {
                "kind": "classifiedIntent",
                "value": "workflow-probe"
              },
              {
                "kind": "replyAction",
                "value": "offer-probe"
              }
            ],
            "judge": {
              "enabled": false
            }
          }
        },
        {
          "harness": "chat",
          "input": {
            "message": "Use the Headline layer and complete the workflow.",
            "probeContext": {
              "probeId": "probe-1",
              "domain": "photoshop-layers",
              "summary": "PSD has Headline and Logo layers",
              "options": [
                {
                  "id": "layer-headline",
                  "label": "Headline"
                },
                {
                  "id": "layer-logo",
                  "label": "Logo"
                }
              ]
            }
          },
          "assertions": {
            "deterministic": [
              {
                "kind": "classifiedIntent",
                "value": "workflow-clarify"
              },
              {
                "kind": "shotTask",
                "shotIndex": 1,
                "task": "workflow-authoring"
              },
              {
                "kind": "replyAction",
                "value": "offer-run"
              },
              {
                "kind": "sidecarWorkflowSchema",
                "value": "@executioncontrolprotocol.workflow"
              }
            ],
            "judge": {
              "enabled": false
            }
          }
        }
      ]
    },
