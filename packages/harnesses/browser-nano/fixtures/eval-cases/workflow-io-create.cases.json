      "harness": "workflow-authoring",
      "model": "default",
      "input": {
        "request": "Create WORKFLOW generate-from-prompt with ACCEPTS WITH prompt:string! and STEP generate USES @executioncontrolprotocol/chrome-ai.generate with WITH prompt = REF prompt."
      },
      "assertions": {
        "deterministic": [
          {
            "kind": "invokeSuccess"
          },
          {
            "kind": "artifactSchema",
            "value": "@executioncontrolprotocol.workflow"
          },
          {
            "kind": "validationValid"
          },
          {
            "kind": "stepUses",
            "capabilityId": "@executioncontrolprotocol/chrome-ai.generate"
          },
          {
            "kind": "workflowAcceptsHasProperties",
            "properties": [
              "prompt"
            ]
          },
          {
            "kind": "workflowAcceptsRefUsed",
            "property": "prompt"
          }
        ],
        "judge": {
          "enabled": false
        }
      }
    },
